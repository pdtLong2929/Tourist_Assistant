# Exclude local environmental secrets
.env
.env.*

# Exclude heavy raw geospatial CSV files (already uploaded to Firebase Storage)
data/NodesnEdges/Nodes/*.csv
data/NodesnEdges/Edges/*.csv

# Exclude local serialized graphs (unless you want to pack them in the image)
# data/serialized_graphs/*.pkl.gz

# Exclude python development cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Exclude IDE and workspace files
.git/
.github/
.vscode/
.idea/
*.md
docker-compose.yml
